        <item name="colorPrimaryVariant">@color/grid_blue</item>
        <item name="colorOnPrimary">@color/bg_main</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
