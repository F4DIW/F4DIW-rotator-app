<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Header & Connection Status ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeWidth="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <View
                    android:id="@+id/indicatorBt"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@color/status_disconnected" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="F4DIW ROTATOR"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DÉCONNECTÉ"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Real-time Position Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="@color/grid_blue"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POSITION ACTUELLE"
                    android:textColor="@color/label_blue"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvAz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="000.0°"
                    android:textColor="@color/white"
                    android:textSize="56sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00.0°"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/label_blue"
                    android:textSize="10sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Target Inputs ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="AZ (0-360°)"
                android:layout_marginEnd="10dp"
                app:hintTextColor="@color/white"
                app:boxStrokeColor="@color/white"
                app:boxBackgroundColor="@color/bg_card"
                android:textColorHint="@color/text_secondary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="EL (0-90°)"
                app:hintTextColor="@color/white"
                app:boxStrokeColor="@color/white"
                app:boxBackgroundColor="@color/bg_card"
                android:textColorHint="@color/text_secondary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ── Action Buttons ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="ENVOYER"
            android:enabled="false"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/status_connected"
            android:textColor="@color/bg_main"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="STOP"
                android:enabled="false"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/status_disconnected"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPark"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="PARK"
                android:enabled="false"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/white"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ── Connection Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONNEXION"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/white"
            app:strokeColor="@color/status_connected"
            app:strokeWidth="1dp"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/status_disconnected"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
